      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-inventory"
          },
          "format": 1,
          "rawSql": "SELECT product_id, toFloat64(sum(stock)) AS stock\nFROM inventory.inventory_stock\nGROUP BY product_id\nORDER BY product_id",
          "queryType": "table",
          "editorType": "sql",
          "pluginVersion": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "max": 20
        },
        "overrides": []
      },
