            "uid": "clickhouse-inventory"
          },
          "format": 0,
          "rawSql": "SELECT toStartOfMinute(occurred_at) AS time,movement AS metric,COUNT(*) AS value FROM inventory.fact_movements WHERE $__timeFilter(occurred_at) GROUP BY 1,2 ORDER BY 1",
          "queryType": "timeseries",
          "editorType": "sql",
          "pluginVersion": ""
