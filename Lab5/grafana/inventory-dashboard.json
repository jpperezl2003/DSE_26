      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-inventory"
          },
          "format": 1,
          "rawSql": "SELECT AVG(dateDiff('millisecond',occurred_at,ingested_at))/1000.0 AS latency_seconds FROM inventory.fact_movements WHERE $__timeFilter(occurred_at)",
