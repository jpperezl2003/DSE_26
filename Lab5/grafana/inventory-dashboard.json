      "title": "Existencias por producto (todos los almacenes)",
      "type": "bargauge",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-inventory"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
