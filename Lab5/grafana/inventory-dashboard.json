    {
      "id": 8,
      "title": "Movimientos diarios (periodo)",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse-inventory"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-inventory"
          },
          "format": 1,
          "rawSql": "SELECT\n    toDate(occurred_at) AS day,\n    warehouse_id,\n    product_id,\n    countIf(movement = 'entrada') AS entries,\n    countIf(movement = 'salida') AS exits,\n    sum(quantity_delta) AS net_movement\nFROM inventory.fact_movements\nWHERE $__timeFilter(occurred_at)\nGROUP BY day, warehouse_id, product_id\nORDER BY day DESC, product_id\nLIMIT 100",
          "queryType": "table",
          "editorType": "sql",
          "pluginVersion": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
